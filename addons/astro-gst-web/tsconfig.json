{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"typeRoots": ["./node_modules/@types", "./src/types"],
		"types": ["node"],
		"allowJs": true,
		"checkJs": false,
		"noImplicitAny": false
	},
	"exclude": [
		"node_modules",
		"dist",
        "public/lib/scripts/*.js"
	]
}
